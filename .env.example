# Copy this file to .env and fill in values before running.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# SECURITY: CORS_ORIGIN=* allows ANY origin — acceptable only on a trusted local
# network. For production or internet-facing deployments, restrict this to the
# exact origin of your frontend, e.g. http://192.168.1.50:3000
CORS_ORIGIN=*
